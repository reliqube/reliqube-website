# ─────────────────────────────────────────────────────────────
# Reliqube — Environment Variables
# Copy to .env.local for local dev. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── SEO Verification ──────────────────────────────────────────
# Add your Google Search Console verification token here
# (found in Search Console > Settings > Ownership verification > HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Contact Form (pick one provider) ─────────────────────────

# Option A — Resend (recommended)
# https://resend.com → API Keys → Create API Key
RESEND_API_KEY=

# Option B — Formspree endpoint
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# ── Analytics (optional) ─────────────────────────────────────

# Vercel Analytics — enabled in vercel.json, no key needed
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=  # auto-injected by Vercel

# Plausible (privacy-friendly alternative)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=reliqube.com

# ── Deployment ────────────────────────────────────────────────
# Set automatically by Vercel — do not set manually
# NEXT_PUBLIC_VERCEL_URL=
# VERCEL_ENV=production | preview | development
